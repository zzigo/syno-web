{
  "name": "syno-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "0BSD",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "vite build && node scripts/check-review.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4190",
    "predev": "node scripts/sync-library.mjs && node scripts/sync-voice-runtime.mjs",
    "prebuild": "node scripts/sync-library.mjs && node scripts/sync-voice-runtime.mjs && node scripts/sync-readme-help.mjs",
    "pretest": "node scripts/sync-library.mjs",
    "multichannel": "node tools/multichannel/server.mjs",
    "docs": "node scripts/sync-readme-help.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lucide/svelte": "^1.77.0",
    "dockview": "^8.0.0",
    "kokoro-js": "^1.2.1",
    "svelte": "^5.0.0",
    "vorbis-encoder-js": "1.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
